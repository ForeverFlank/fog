-- Natural number, per Peano axioms

-- a natual number is either zero, or
-- a successor of another natural number.

Nat : Type
Nat = Zero | Succ Nat   -- Succ(n) = n + 1

-- addition of natural numbers, defined as
--       a + 0 = 0
-- a + Succ(b) = Succ(a + b)

add : Nat -> Nat -> Nat
add a Zero     = a
add a (Succ b) = Succ (add a b)

three = Succ (Succ (Succ Zero))
two = Succ (Succ Zero)

five = add three two






toInt32 : Nat -> Int32
toInt32 Zero     = 0
toInt32 (Succ n) = addInt32 1 (toInt32 n)

main = printLine (toString (toInt32 five))
