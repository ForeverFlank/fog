IO : Type -> Type

unsafeRun : IO a -> a   -- impure!

return : a -> IO a
return value = () => value

join : IO (IO a) -> IO a
join action = () => unsafeRun (unsafeRun action)

fmap : (a -> b) -> IO a -> IO b
fmap fn action = () => fn (unsafeRun action)

bind : IO a -> (a -> IO b) -> IO b
bind action fn = join (fmap fn action)


printLine : String -> IO Unit
printLine str = -- internal stuff


main : IO Unit
main = printLine "Hello fog!"

