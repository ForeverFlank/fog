-- List, a linked list type

List : Type -> Type
List a = Nil | Cons a (List a)

-- concatenate the RHS list at the tail of the LHS list
-- time complexity: O(n)
concat : List a -> List a -> List a
concat Nil         rhs = rhs
concat (Cons x xs) rhs = Cons x (concat xs rhs)

-- map each element of the list by a function
-- time complexity: O(n)
map : (a -> b) -> List a -> List b
map fn Nil         = Nil
map fn (Cons x xs) = Cons (fn x) (map fn xs)

-- insert separators between elements of the list
-- time complexity: O(n)
intersperse : a -> List a -> List a
intersperse item Nil          = Nil
intersperse item (Cons x Nil) = Cons x Nil
intersperse item (Cons x xs)  = Cons x (Cons item (intersperse item xs))

-- fold the list
foldLeft : (a -> b -> a) -> a -> List b -> a
foldLeft fn acc Nil         = acc
foldLeft fn acc (Cons x xs) = foldLeft fn (fn acc x) xs

-- reverse the list, not optimal
-- time complexity: O(n^2)
reverse : List a -> List a
reverse Nil         = Nil
reverse (Cons x xs) = concat (reverse xs) (Cons x Nil)

-- if type check actually works, 
-- reverse = foldLeft (acc : List a => x : a => Cons x acc) Nil 


-- performing list operations

list1 : List Int32
list1 = Cons 1 (Cons 2 (Cons 3 Nil))    -- [1, 2, 3]

list2 : List Int32
list2 = Cons 4 (Cons 5 Nil)             -- [4, 5]

list3 = reverse (concat list1 list2)    -- [5, 4, 3, 2, 1]
list4 = map toString list3
list5 = intersperse ", " list4


main = printLine (foldLeft concatString "" list5)

