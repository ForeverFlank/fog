-- List, a linked list type

List : Type -> Type
List a = Nil | Cons a (List a)

-- prepend and item at the front of the list
-- time complexity: O(1)
prepend: a -> List a -> List a
prepend item list = Cons item list

-- append an item at the tail of the list
-- time complexity: O(n)
append : List a -> a -> List a
append Nil         item = item
append (Cons x xs) item = Cons x (append xs itmem)

-- concatenate the RHS list at the tail of the LHS list
-- time complexity: O(n)
concat : List a -> List a -> List a
concat Nil         rhs = rhs
concat (Cons x xs) rhs = Cons x (append xs rhs)

-- map each element of the list by a function
-- time complexity: O(n)
map : (a -> b) -> List a -> List b
map f Nil         = Nil
map f (Cons x xs) = Cons (f x) (map f xs)

-- reverse the list
-- time complexity: O(n)
reverse : List a -> List a
reverse Nil                  = Nil
reverse (Cons x Nil)         = Cons x Nil
reverse (Cons x (Cons y ys)) = Cons y (reverse (Cons x ys))


