-- ad hoc polymorphism
-- commonly known as interfaces

-- declaring Bool

Bool : Type
Bool = True | False

and : Bool -> Bool -> Bool
and True True = True
and _    _    = False

not : Bool -> Bool
not True  = False
not False = True

-- defining the Eq type class

Eq : Type -> Constraint
Eq a = {
    equal    : a -> a -> Bool
    notEqual : a -> a -> Bool
}

-- implementing Eq to Bool

Eq Bool = {
    equal True  True  = True
    equal False False = True
    equal _     _     = False

    notEqual lhs rhs = not (equal lhs rhs)
}
