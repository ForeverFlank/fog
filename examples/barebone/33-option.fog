-- Option type

Option : Type -> Type
Option a = Some a | None

orElse : Option a -> Option a -> Option a
orElse (Some item) _   = Some item
orElse None        rhs = rhs

a : Option Int32
a = None

b : Option Int32
b = Some 20

c : Option Int32
c = orElse a b  -- Some 20


main = match c {
    Some num => printLine (toString num)
    None     => printLine "none"
}
