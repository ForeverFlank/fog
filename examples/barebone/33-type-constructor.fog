-- Option type

Option : Type -> Type
Option a = Some a + None

orElse : Option a -> Option a
orElse =
    lhs : Option a =>
    rhs : Option a =>
    match lhs {
        Some item => item
        None      => match rhs {
            Some item => item
            None      => None
        }
    }


a = None
b = Some 20
c = orElse a b  -- 20
