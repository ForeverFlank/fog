-- boilerplate Bool

Bool : Type
Bool = True | False

and : Bool -> Bool -> Bool
and True True = True
and _    _    = False

or : Bool -> Bool -> Bool
or False False = False
or _     _     = True

not : Bool -> Bool
not True  = False
not False = True

-- type classes

Eq : Type -> Constraint
Eq a = {
    equal    : a -> a -> Bool
    notEqual : a -> a -> Bool
}

Ord : Type -> Constraint
Ord a = Eq a & {
    lessOrEqual : a -> a -> Bool
}


Eq Int32 = {
    equal    lhs rhs = equalInt32 lhs rhs
    notEqual lhs rhs = not (equal lhs rhs)
}

Ord Int32 = {
    lessOrEqual lhs rhs = lessOrEqualInt32 lhs rhs
}


Ordering : Type
Ordering = Less | Equal | Greater

compare : a -> a -> Ordering
    where Ord a

compare lhs rhs = match (equal lhs rhs) {
    True  => Equal
    False => match (lessOrEqual lhs rhs) {
        True  => Less
        False => Greater
    }
}
