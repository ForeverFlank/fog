-- ad hoc polymorphism
-- commonly known as interfaces

Bool : Type
Bool = True | False

and : Bool -> Bool -> Bool
and True True = True
and _    _    = False

not : Bool -> Bool
not True  = False
not False = True

-- defining the Eq type class

Eq : Type -> Constraint
Eq a = {
    equal    : a -> a -> Bool
    notEqual : a -> a -> Bool
}

-- declaring a type

Option : Type -> Type
Option a = Some a | None

-- implementing the Eq type class
-- to that type

Eq Point = {
    -- value's type must also derive from Eq!
    equal (Some lhs) (Some rhs) = equal lhs rhs
    equal None       None       = True
    equal _          _          = False

    notEqual lhs rhs = not (equal lhs rhs)
}
