-- ad hoc polymorphism
-- commonly known as interfaces

Bool : Type
Bool = True | False

and : Bool -> Bool -> Bool
and = b1 : Bool => b2 : Bool => match (b1, b2) {
    (True, True) => True
    _            => False
}

not : Bool -> Bool
not = b : Bool => match b {
    True  => False
    False => True
}

-- defining the Equatable type class

Equatable : Type -> Constraint
Equatable a = {
    equal    : a -> a -> Bool
    notEqual : a -> a -> Bool
}

-- declating a type

Option : Type -> Type
Option a = Some a | None

-- implementing the Equatable type class
-- to that type

Equatable Point = {
    equal (Some lhs) (Some rhs) = equal


    notEqual lhs rhs = not (equal lhs rhs)
}
