-- ad hoc polymorphism
-- commonly known as interfaces

Bool : Type
Bool = True | False

and : Bool -> Bool -> Bool
and True True = True
and _    _    = False

not : Bool -> Bool
not True  = False
not False = True

-- defining the Equatable type class

Equatable : Type -> Constraint
Equatable a = {
    equal    : a -> a -> Bool
    notEqual : a -> a -> Bool
}

-- declating a type

Option : Type -> Type
Option a = Some a | None

-- implementing the Equatable type class
-- to that type

Equatable Point = {
    -- value's type must also derive from Equatable!
    equal (Some lhs) (Some rhs) = equal lhs rhs
    equal None       None       = True
    equal _          _          = False

    notEqual lhs rhs = not (equal lhs rhs)
}
